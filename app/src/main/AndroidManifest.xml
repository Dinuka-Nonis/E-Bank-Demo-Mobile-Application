<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EBank">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Replaces HomeActivity, TransferActivity and ConfirmTransferActivity: those
             screens are now DashboardFragment, TransferFragment and ConfirmationFragment,
             all hosted here. -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SuccessActivity" android:exported="false" />

    </application>
</manifest>
