<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light_gray"
    tools:context=".ConfirmationFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <!-- Header: back button + title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_back"
                        android:layout_width="@dimen/avatar_size"
                        android:layout_height="@dimen/avatar_size"
                        android:background="@drawable/bg_circle_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/confirm_title"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recipient summary -->
                <TextView
                    android:id="@+id/tv_recipient_initials"
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:background="@drawable/bg_avatar_default"
                    android:gravity="center"
                    android:text="@string/home_txn1_initials"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold"
                    tools:ignore="SpUsage" />

                <TextView
                    android:id="@+id/tv_recipient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/home_txn1_name"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_account_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="@string/confirm_account_info"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/text_xs" />

                <!-- Details card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:background="@drawable/bg_amount_field"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Amount row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confirm_label_amount"
                            android:textColor="@color/text_gray"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/tv_amount_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_value_amount"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- Fee row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confirm_label_fee"
                            android:textColor="@color/text_gray"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/tv_fee_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_value_fee"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- From row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confirm_label_from"
                            android:textColor="@color/text_gray"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_value_from"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- Date row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confirm_label_date"
                            android:textColor="@color/text_gray"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/tv_date_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_value_date"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:background="@color/border_gray" />

                    <!-- Total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/confirm_label_total"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confirm_value_total"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_md"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Edit transfer link -->
                <TextView
                    android:id="@+id/tv_edit_transfer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/confirm_edit_transfer"
                    android:textColor="@color/blue_primary"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom actions: confirm button + cancel link -->
        <LinearLayout
            android:id="@+id/bottom_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/btn_confirm_send"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/confirm_button_send"
                android:textColor="@color/white"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_sm"
                android:text="@string/confirm_button_cancel"
                android:textColor="@color/blue_primary"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
