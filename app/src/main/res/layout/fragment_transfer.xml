<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_light_gray"
        tools:context=".TransferFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/background_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="480dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_content"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                app:layout_constraintBottom_toTopOf="@id/btnSubmit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnCancel"
                            android:layout_width="@dimen/avatar_size"
                            android:layout_height="@dimen/avatar_size"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/backward_navigation"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:text="@string/transfer_title"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Recipient quick-select -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/transfer_recipient_label"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_sm" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/recipient_kasun"
                                android:layout_width="@dimen/icon_badge_size"
                                android:layout_height="@dimen/icon_badge_size"
                                android:background="@drawable/bg_avatar_selected"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/home_txn1_initials"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/transfer_recipient_kasun_name"
                                android:textColor="@color/text_dark"
                                android:textSize="@dimen/text_xs"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/recipient_priya"
                                android:layout_width="@dimen/icon_badge_size"
                                android:layout_height="@dimen/icon_badge_size"
                                android:background="@drawable/bg_avatar_default"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/home_txn2_initials"
                                android:textColor="@color/text_dark"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/transfer_recipient_priya_name"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/recipient_ravindu"
                                android:layout_width="@dimen/icon_badge_size"
                                android:layout_height="@dimen/icon_badge_size"
                                android:background="@drawable/bg_avatar_default"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/transfer_recipient_ravindu_initials"
                                android:textColor="@color/text_dark"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/transfer_recipient_ravindu_name"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/btn_add_recipient"
                                android:layout_width="@dimen/icon_badge_size"
                                android:layout_height="@dimen/icon_badge_size"
                                android:background="@drawable/bg_avatar_add_dashed"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="@string/plus_mark"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_lg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/transfer_add_new_label"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_xs" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Recipient account number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/transfer_recipient_account_label"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_sm" />

                    <EditText
                        android:id="@+id/etRecipientAccount"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical|start"
                        android:hint="@string/transfer_recipient_account_hint"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_gray_light"
                        android:textSize="@dimen/text_md" />

                    <!-- Recipient name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/transfer_recipient_name_label"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_sm" />

                    <EditText
                        android:id="@+id/etRecipientName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical|start"
                        android:hint="@string/transfer_recipient_name_hint"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_gray_light"
                        android:textSize="@dimen/text_md" />

                    <!-- Amount -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/transfer_amount_label"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_sm" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:background="@drawable/bg_amount_field"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/currency"
                                android:textColor="@color/blue_primary"
                                android:textSize="@dimen/text_xxl"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="@string/_0_00"
                                android:inputType="numberDecimal"
                                android:minWidth="120dp"
                                android:padding="0dp"
                                android:text="@string/transfer_amount_value"
                                android:textColor="@color/blue_primary"
                                android:textColorHint="@color/text_gray_light"
                                android:textCursorDrawable="@null"
                                android:textSize="@dimen/text_xxl"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/transfer_available_balance_prefix"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_xs" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_balance_amount"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_xs" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Note -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/transfer_note_label"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_sm" />

                    <EditText
                        android:id="@+id/etRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical|start"
                        android:hint="@string/transfer_note_hint"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:text="@string/transfer_note_default_text"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_gray_light"
                        android:textSize="@dimen/text_md" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_button_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/transfer_review_button"
                android:textColor="@color/white"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
